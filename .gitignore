# Trip photo folders — inputs live beside the code but are never committed.
/2026-07 Argentina/

# What `fototrip export-album` stages beside the trip folder: a partial export
# and a run report listing every filename and library UUID. Both survive a
# refusal on purpose, as evidence, and neither belongs in the repo.
/2026-07 Argentina.*
*.report.csv

# Raw media, wherever it turns up. PNG/SVG/ICO stay allowed for site assets.
*.jpeg
*.jpg
*.heic
*.heif
*.mov
*.mp4

# Generated sites and build caches
/site/
/out/
.fototrip-cache/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# macOS
.DS_Store

# Anything `fototrip export-album` stages, whatever the trip folder is called.
# The rules above name one folder; these do not depend on its name.
*.incoming/
*.previous/

# Export targets created at the repo root, e.g. `-o export-argentina`.
/export*
