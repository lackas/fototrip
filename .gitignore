# Trip photo folders live beside the code and are never committed. Name yours
# in .git/info/exclude rather than here, so the repo carries no private folder
# names; the patterns below cover whatever you call them.
/trip/
/photos/

# What `fototrip export-album` stages beside the trip folder: a partial export
# and a run report listing every filename and library UUID. Both survive a
# refusal on purpose, as evidence, and neither belongs in the repo.
*.incoming/
*.previous/
*.report.csv

# Raw media, wherever it turns up. PNG/SVG/ICO stay allowed for site assets.
*.jpeg
*.jpg
*.heic
*.heif
*.mov
*.mp4

# Generated sites and build caches
/site/
/out/
.fototrip-cache/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# macOS
.DS_Store

# Export targets created at the repo root, e.g. `-o export-trip`.
/export*
