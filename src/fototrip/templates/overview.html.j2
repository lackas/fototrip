<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<link rel="stylesheet" href="overview.css">
</head>
<body>
<header>
  <h1>{{ title }}</h1>
  {% if subtitle %}<p class="subtitle">{{ subtitle }}</p>{% endif %}
  <p class="count">{{ trips | length }} trip{{ "" if trips | length == 1 else "s" }}</p>
</header>

{% if trips %}
<main>
  {% for trip in trips %}
  <a class="trip" href="{{ trip.href }}">
    {% if trip.cover %}<img class="cover" src="{{ trip.cover }}" loading="lazy" decoding="async" alt="">
    {% else %}<span class="cover"></span>{% endif %}
    <span class="body">
      <h2>{{ trip.title }}</h2>
      {% if trip.subtitle %}<span class="subtitle">{{ trip.subtitle }}</span>{% endif %}
      <span class="meta">
        <span class="dates">{{ trip.first_day }}{% if trip.last_day != trip.first_day %} – {{ trip.last_day }}{% endif %}</span>
        <span class="count">{{ trip.photos }} photo{{ "" if trip.photos == 1 else "s" }}</span>
        <span>{{ trip.days }} day{{ "" if trip.days == 1 else "s" }}</span>
      </span>
    </span>
  </a>
  {% endfor %}
</main>
{% else %}
<p class="empty">No built trips here yet.</p>
{% endif %}
</body>
</html>
