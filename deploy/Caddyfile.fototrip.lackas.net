# Vorlage, KEINE Live-Konfiguration. Dieses Repo ist oeffentlich, daher
# stehen hier Platzhalter statt Geheimnissen. Die echten Werte stehen
# ausschliesslich in /var/www/caddy/conf/Caddyfile auf server.lackas.net:
#   BCRYPT_HASH_SIEHE_SERVER   -> docker exec -it caddy caddy hash-password --bcrypt-cost 4
#   UNLOCK_PATH_SIEHE_SERVER   -> openssl rand -hex 32
#   COOKIE_WERT_SIEHE_SERVER   -> openssl rand -hex 32
#   HOME_IP                    -> die eigene oeffentliche Adresse
# Der Mechanismus darf oeffentlich dokumentiert sein, die Werte nicht.
#
# Fototrip — gebaute Reiseseiten, rein statisch (kein Prozess, kein Backend).
# Payload liegt auf /home (dort sind die TBs), read-only ins Container gemountet
# als /srv/fototrip; je Reise ein Unterverzeichnis, Uebersicht als index.html.
# Privat: Basic Auth, aber nur als Sichtschutz gegen Suchmaschinen und
# Zufallsfunde — kein Schutz gegen einen Angreifer, der den Server hat, denn
# der kaeme sowieso direkt an die Bilder. Daher bewusst **bcrypt-Cost 4** statt
# der hier sonst ueblichen 14: gemessen auf dieser Maschine 1,0 ms je
# Verifikation gegen 830 ms bei Cost 14, und eine Galerie loest >100
# Bild-Requests pro Aufruf aus (Cost 14 = >80 s CPU je Seitenaufruf).
# Bitte nicht "haerten" — die Sicherheit steckt hier im Passwort (14 Zeichen
# zufaellig, nicht anderweitig verwendet), nicht im Kostenfaktor.
fototrip.lackas.net {
	root * /srv/fototrip

	# Heimnetz und Tailnet duerfen ohne Passwort rein (in Apache waere das
	# `Satisfy Any`). Caddy kennt keinen solchen Schalter, aber jede Direktive
	# nimmt einen Matcher — also greift basic_auth nur fuer alles, was NICHT
	# aus diesen Netzen kommt. HOME_IP ist die Hausadresse (dynamisch:
	# aendert sie sich, kommt hier wieder die Passwortabfrage, kein Aussperren),
	# 100.64.0.0/10 ist der Tailscale-CGNAT-Bereich. Letzteres wirkt nur, wenn
	# die Anfrage wirklich ueber das Tailnet eintrifft, siehe Doku.

	# Einmal-Link fuer die Familie. Hintergrund: Browser bieten
	# Basic-Auth-Zugangsdaten nicht im Passwortmanager an, also fragt das
	# Formular bei jedem Besuch neu — fuer Angehoerige unbrauchbar. Wer
	# /unlock/<geheimnis> einmal aufruft, bekommt ein Cookie und wird danach
	# nicht mehr gefragt. Rein statisch: Caddy setzt das Cookie und matcht
	# darauf, kein Prozess, kein Backend. Pfad und Cookie sind je 64
	# Hex-Zeichen (256 Bit) — nicht lesbar, nicht merkbar, man muss den
	# vollstaendigen Link bekommen haben. Widerrufen = Cookie-Wert hier
	# aendern, dann sind alle verteilten Links sofort wertlos.
	# Max-Age sind 400 Tage: mehr setzen Chrome und Edge ohnehin auf 400
	# herunter, das ist also das praktische Maximum (gewuenscht war >= 1 Jahr).
	@unlock path /unlock/UNLOCK_PATH_SIEHE_SERVER
	handle @unlock {
		header Set-Cookie "ft_auth=COOKIE_WERT_SIEHE_SERVER; Path=/; Max-Age=34560000; Secure; HttpOnly; SameSite=Lax"
		# Wildcard-Matcher ist Pflicht: `redir / 302` wuerde das `/` als
		# Matcher lesen und "302" als Ziel setzen (Location: 302, Ergebnis 404).
		redir * / 302
	}

	# Passwort nur verlangen, wenn weder IP noch Cookie passen. Die drei
	# Bedingungen sind UND-verknuepft. Der unlock-Pfad muss ausgenommen sein,
	# sonst braeuchte man das Passwort, um ueberhaupt an das Cookie zu kommen.
	@needs_auth {
		not remote_ip HOME_IP/32 100.64.0.0/10
		not header Cookie *ft_auth=COOKIE_WERT_SIEHE_SERVER*
		not path /unlock/*
	}
	basic_auth @needs_auth {
		fototrip BCRYPT_HASH_SIEHE_SERVER
		lackas BCRYPT_HASH_SIEHE_SERVER
	}

	# Nur Text komprimieren — JPEG/PNG/WebP sind schon komprimiert, da kostet
	# encode nur CPU.
	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow"
		-Server

		# Gegen den echten Seiteninhalt geprueft (nicht geschaetzt): kein
		# Inline-Script, kein Inline-Style, keine on*=-Handler, keine
		# style=-Attribute; CSS/JS/fetch alles same-origin. Daher strikt, ohne
		# jedes 'unsafe-inline' — fototrip hat die zwei Inline-Bloecke am
		# 30.09.2026 aufgeloest (Tile-Config wandert in photos.json, Uebersicht
		# bekam overview.css) und testet die Richtlinie im Browser erzwungen.
		# Einzige Drittquelle sind die Kartenkacheln. Die Tile-URL ist jetzt
		# *Daten* in photos.json — verlaesst sie die hier gelisteten Hosts,
		# bricht die Karte hier und nicht im Generator.
		#
		# Die nackte Domain UND die Subdomains. Ein CSP-Wildcard deckt
		# `tile.openstreetmap.org` NICHT ab, nur `a.tile.openstreetmap.org`:
		# `*.` verlangt mindestens ein Label davor. Seit die veralteten
		# {s}-Subdomains aus der Tile-URL raus sind, kommen die Kacheln von
		# der nackten Domain. Daran ist die Karte am 30.09.2026 gestorben,
		# mit 18 CSP-Blocks und keinem einzigen Request bei OSM.
		#
		# data: deckt Leaflets Zoom-Platzhalter. Stile von Leaflet/PhotoSwipe laufen per CSSOM, das
		# faellt nicht unter style-src.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://server.arcgisonline.com; style-src 'self'; script-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'"
	}

	# Die vier Regeln sind absichtlich gegenseitig exklusiv, damit keine von ihnen
	# davon abhaengt, in welcher Reihenfolge Caddy gleichnamige Direktiven
	# anwendet. Leaflets marker-icon.png passt sonst auf @vendor UND @media,
	# und die Antwort haengt an einer Annahme ueber Caddys Innenleben statt an
	# dem, was hier steht.

	# Die mitgelieferten Bibliotheken haengen an einer Version im Pfad und
	# aendern sich unter demselben Pfad nie.
	@vendor path */vendor/*
	header @vendor Cache-Control "public, max-age=31536000, immutable"

	# Fotos behalten ihren Dateinamen ueber einen Rebuild, der Inhalt kann
	# sich aendern (neuer Export, anderes --web-px). Eine Woche hiesse: ein
	# korrigiertes Foto wird eine Woche lang falsch ausgeliefert. Ein Tag —
	# ein Rebuild heilt sich selbst, Wiederbesuche am selben Tag bleiben
	# gratis. Dauerhaft cachen geht erst mit Inhalts-Hash im Dateinamen.
	@media {
		not path */vendor/*
		path *.jpg *.jpeg *.png *.webp *.avif *.gif *.mp4 *.mov
	}
	header @media Cache-Control "public, max-age=86400"

	# Alles, was ein Build neu schreibt, muss revalidiert werden. Mit ETag
	# kostet das einen 304 und nicht die halbe Megabyte photos.json. Ohne die
	# Regel schickt Caddy gar kein Cache-Control, der Browser raet sich eine
	# Frist zusammen, und ein Deploy kann unsichtbar bleiben.
	@build {
		not path */vendor/*
		path *.json *.js *.css
	}
	header @build Cache-Control "no-cache"

	# HTML nie cachen, damit ein neuer Deploy sofort sichtbar ist. Das `*/`
	# erfasst die Verzeichnis-Indizes (`/`, `/argentina-2026/`) mit, die als
	# index.html ausgeliefert werden und nicht auf *.html enden.
	@html path *.html */
	header @html Cache-Control "no-cache"

	file_server

	import access_log
}
